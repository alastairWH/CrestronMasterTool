<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="CrestronMasterTool.WinUI.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / Command bar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Browse" Style="{StaticResource TitleTextBlockStyle}" />
                <RadioButtons x:Name="TypeSelector" SelectionChanged="OnTypeChanged" />
            </StackPanel>

            <AutoSuggestBox
                Grid.Column="1"
                x:Name="SearchBox"
                PlaceholderText="Search products"
                TextChanged="OnSearchChanged" />

            <Button
                Grid.Column="2"
                Content="Logout"
                Click="OnLogoutClick" />
        </Grid>

        <!-- List -->
        <Border Grid.Row="1" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
            <ListView x:Name="ProductsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <ComboBox
                                Grid.Column="2"
                                ItemsSource="{Binding Versions}"
                                DisplayMemberPath="DisplayText"
                                SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                PlaceholderText="Select version"
                                IsEnabled="{Binding HasVersions}" />

                            <TextBlock Grid.Column="3" Text="{Binding Status}" Opacity="0.75" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="DownloadButton" Content="Download Selected" Style="{StaticResource PrimaryAction}" Click="OnDownloadClick" />
                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed" Click="OnCancelClick" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="DownloadMBStatus" Text="" Opacity="0.75" />
            <TextBlock x:Name="FooterStatus" Text="" Opacity="0.75" />
        </StackPanel>
    </Grid>
</Page>
