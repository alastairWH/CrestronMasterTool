<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="CrestronMasterTool.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="16"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                MaxWidth="520"
                Translation="0,6,0">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>

                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Crestron Master Tool" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Sign in to Crestron SFTP" Opacity="0.75" />
                    </StackPanel>

                    <TextBox
                        x:Name="UsernameBox"
                        Header="Username"
                        PlaceholderText="Your Crestron username"
                        InputScope="Text" />

                    <PasswordBox
                        x:Name="PasswordBox"
                        Header="Password"
                        PlaceholderText="Your password" />

                    <CheckBox x:Name="RememberMeCheck" Content="Remember me" />

                    <Button
                        x:Name="LoginButton"
                        Content="Login"
                        Style="{StaticResource PrimaryAction}"
                        Click="OnLoginClick" />

                    <TextBlock
                        x:Name="StatusText"
                        Text=""
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            Opacity="0.6"
            Text="Unofficial tool • Uses your Crestron credentials" />
    </Grid>
</Page>
